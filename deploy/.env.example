# Copy to deploy/.env on the server (gitignored) and fill in.
DOMAIN=ateliersdevs.tech
WEB_PORT=3020

# MongoDB root user, created on first start. Generate the password with: openssl rand -hex 24
MONGO_ROOT_USER=clave
MONGO_ROOT_PASSWORD=

# Firebase web config, baked into the frontend at build time (same values as your local .env.local)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=ats-resume-grader.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ats-resume-grader
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
