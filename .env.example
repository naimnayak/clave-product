# Copy to .env.local (gitignored) and fill in.
# The Vite dev server proxies /api to the FastAPI backend on http://localhost:8000.
VITE_API_BASE_URL=/api

# Firebase web app config (Firebase console > Project settings > Your apps). Project: ats-resume-grader
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=ats-resume-grader.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ats-resume-grader
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
