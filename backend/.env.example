# Copy to backend/.env and fill in. Never commit the real .env or anything in secrets/.
APP_ENV=development
# Admin panel owners (/admin): comma-separated emails, must be verified (Google sign-in is). Owners are
# always full admins; they can add more admins and support staff from the panel.
ADMIN_EMAILS=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WEB_BASE_URL=http://localhost:5173

# MongoDB
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=clave

# Firebase Admin (verifies the ID tokens sent by the frontend). GCP/Firebase project: ats-resume-grader
FIREBASE_SERVICE_ACCOUNT=secrets/firebase-service-account.json

# AI model. Runs inside the GCP project with a service account by default ...
AI_USE_CLOUD_PROJECT=true
AI_CLOUD_PROJECT=ats-resume-grader
AI_CLOUD_LOCATION=global
AI_CREDENTIALS_FILE=secrets/ai-service-account.json
# ... or with a provider API key (set AI_USE_CLOUD_PROJECT=false)
AI_API_KEY=
# Model IDs from your AI provider's model list. AI_MODEL does generation and analysis;
# AI_MODEL_LITE handles short tasks (rewrites, chat, parsing reviews). Check the provider's
# deprecation schedule when changing them.
AI_MODEL=
AI_MODEL_LITE=
AI_THINKING_LEVEL=low
AI_TIMEOUT_SECONDS=90
AI_RATE_LIMIT=30/minute
AI_DAILY_LIMIT_FREE=15
AI_DAILY_LIMIT_PAID=300
# memory:// for a single process; redis://host:6379 when running several (pip install redis)
RATE_LIMIT_STORAGE_URI=memory://

# Plans (developer-handoff/07-SUBSCRIPTION-USAGE.md). Keep ENFORCE_PLAN_LIMITS=true in production.
# These seed the `plans` collection on first start. After that, edit the documents in MongoDB
# (db.plans) to change prices or limits; changing these values won't update existing plans.
ENFORCE_PLAN_LIMITS=true
FREE_RESUME_LIMIT=5
SINGLE_RESUME_PRICE_INR=49
MONTHLY_PRICE_INR=199
FREE_MOCK_INTERVIEWS=1
CHAT_DAILY_LIMIT_FREE=10
CHAT_DAILY_LIMIT_PAID=100
# Free resumes are also capped per device and per device + IP pair (other devices on the same network
# are unaffected). Set the salt to a long random value: openssl rand -hex 32
FREE_RESUME_GUARD_ENABLED=true
FREE_RESUMES_PER_DEVICE=5
FREE_RESUME_GUARD_HASH_SALT=
# Career assistant: conversations stay open this long, then their key points become long-term memory.
CHAT_SESSION_HOURS=48

# Razorpay (payments return 503 until set). Webhook: Razorpay Dashboard -> Webhooks -> URL
# https://<your-domain>/api/payments/webhook, events payment.captured and order.paid, same secret here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Apify: the Pro job feed and live search (raw token or an Apify URL containing ?token=)
APIFY_API_TOKEN=
# Scraping LinkedIn is against LinkedIn's terms; it stays off unless you turn it on.
APIFY_LINKEDIN_ENABLED=false
# Actor per job board. Override when an actor is retired from the Apify store.
APIFY_ACTOR_INDEED=misceres/indeed-scraper
APIFY_ACTOR_NAUKRI=memo23/naukri-scraper
APIFY_ACTOR_LINKEDIN=fetchclub/linkedin-jobs-scraper
APIFY_ACTOR_INTERNSHALA=crawloop/internshala-scraper
APIFY_ACTOR_FOUNDIT=crawloop/foundit-jobs-scraper

# Pro personal job feed: searches come from each user's resume and job descriptions.
JOB_FEED_SOURCES=indeed,naukri,linkedin,internshala,foundit
JOB_FEED_RESULTS_PER_SEARCH=10
JOB_FEED_REFRESH_DAYS=3.5
JOB_FEED_SCHEDULED_PER_MONTH=8
JOB_FEED_JD_SEARCHES_PER_MONTH=5
JOB_FEED_CACHE_HOURS=24
# Hard monthly cap on listings fetched from Apify across all users (0 = no cap). ~$3-5 per 1,000.
APIFY_MONTHLY_RESULT_LIMIT=3000
APIFY_COST_PER_1000_USD=5

# Optional shared-catalog ingestion. 0 = don't run inside the API (the Pro feed runs hourly regardless).
JOB_INGEST_INTERVAL_HOURS=0
JOB_INGEST_QUERIES=
JOB_INGEST_LOCATION=India
JOB_INGEST_SOURCES=indeed,naukri
JOB_INGEST_PER_QUERY=10
JOB_INGEST_MAX_QUERIES=6
JOB_MAX_AGE_DAYS=30
JOB_MATCH_NOTIFY_THRESHOLD=85
SEED_DEMO_JOBS=true

# Uploads: set UPLOAD_BUCKET to store files in Cloud Storage (otherwise MongoDB)
MAX_UPLOAD_BYTES=10485760
UPLOAD_RETENTION_DAYS=7
UPLOAD_BUCKET=
UPLOAD_PREFIX=clave-uploads

# Email (SMTP). Leave SMTP_HOST empty to skip sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=Clave <hello@clave.app>
SUPPORT_INBOX=support@clave.app

NOTIFICATION_RETENTION_DAYS=90
